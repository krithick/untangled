# Copy to .env and fill in. Never commit .env.
NODE_ENV=production

# The public address of the site (https, no trailing slash) and its bare domain for the HTTPS proxy.
APP_URL=https://untangle.example.com
DOMAIN=untangle.example.com

# Shown on the privacy and terms pages.
CONTACT_EMAIL=hello@example.com

# Any SMTP provider (Resend, Postmark, Amazon SES, Brevo...). Needed for password reset emails.
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
EMAIL_FROM="Untangle <hello@example.com>"

# Optional
# PORT=3000
# DATA_DIR=/data
# LOG_REQUESTS=0
